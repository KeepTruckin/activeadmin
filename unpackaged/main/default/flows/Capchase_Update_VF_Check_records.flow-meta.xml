    <decisions>
        <description>Route to appropriate status assignment based on Capchase KYB_Result value per ESYS-27314 flowchart.
KYB_Result values confirmed from flowchart: APPROVED, PENDING, REJECTED, MANUAL_REVIEW, MISSING_INFO, DATA_REQUIRED, EXPIRED.
VERIFY: confirm exact uppercase values against Capchase API — only APPROVED is confirmed from org data.</description>
        <name>KYB_Result_Value</name>
        <label>KYB Result Value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Expired / Unrecognised - no update</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.capchaseapp__KYB_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>APPROVED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_VF_check_status_Approved</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
        <rules>
            <name>Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.capchaseapp__KYB_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>REJECTED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_VF_check_status_Declined</targetReference>
            </connector>
            <label>Rejected - Declined</label>
        </rules>
        <rules>
            <name>Pending_Lender_Decision</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.capchaseapp__KYB_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PENDING</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_VF_check_status_Pending_Lender_Decision</targetReference>
            </connector>
            <label>Pending Lender Decision</label>
        </rules>
        <rules>
            <name>Manual_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.capchaseapp__KYB_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MANUAL_REVIEW</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Assign_VF_check_status_Pending_Lender_Decision</targetReference>
            </connector>
            <label>Manual Review - Pending Lender Decision</label>
        </rules>
        <rules>
            <name>Missing_Info</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.capchaseapp__KYB_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MISSING_INFO</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_VF_check_status_Information_Required</targetReference>
            </connector>
            <label>Missing Info - Information Required</label>
        </rules>
        <rules>
            <name>Data_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.capchaseapp__KYB_Result__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DATA_REQUIRED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Assign_VF_check_status_Information_Required</targetReference>
            </connector>
            <label>Data Required - Information Required</label>
        </rules>
    </decisions>
